TICK_SECONDS=1
# Reference agent works without any credentials.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
# true blocks automated actions; approval UI is intentionally not implemented.
REQUIRE_ACTION_APPROVAL=false

# External Agent registration token; keep only in your local .env.
INCIDENTLAB_AGENT_TOKEN=
