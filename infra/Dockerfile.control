FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.9.18 /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev
COPY packages packages
COPY apps/__init__.py apps/__init__.py
COPY apps/control_api apps/control_api
COPY simulator simulator
COPY evaluator evaluator
COPY lab_mcp lab_mcp
COPY knowledge/sop knowledge/sop
ENV PATH="/app/.venv/bin:$PATH" LAB_DB=/data/lab.sqlite PYTHONUNBUFFERED=1
RUN useradd --uid 10001 --create-home lab && mkdir /data && chown lab:lab /data
USER lab
CMD ["uvicorn", "apps.control_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
